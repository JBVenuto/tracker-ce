---
import Layout from '../layouts/Layout.astro';

export function getStaticPaths() {
    const docs = import.meta.glob('../../../docs/*.md', {
        eager: true,
        import: 'Content',
    });

    return Object.entries(docs)
        .filter(([path]) => !path.endsWith('/_Sidebar.md'))
        .map(([path, Content]) => ({
            params: { slug: path.slice(path.lastIndexOf('/') + 1, -3) },
            props: { Content },
        }));
}

const { Content } = Astro.props;
---

<Layout>
    <article>
        <Content />
    </article>
</Layout>
